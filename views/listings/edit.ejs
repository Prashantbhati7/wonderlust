<%-layout("/layouts/boilerplate") %>
<h2 class="center">Edit Listing</h2>
<div class="row">
<div class="col-8 offset-2">
<form method="post" action="/listings/<%= listing._id %>?_method=PATCH" novalidate class="needs-validation">

    <div class="mb-3">
        <label for="title" class="form-label">Title:</label>
        <input value="<%= listing.title %>" type="text" name="title" id="title" class="form-control" required />
        <div class="valid-feedback">
            title is valid
        </div>
        <div class="invalid-feedback">title is invalid</div>
    </div>

    <div class="mb-3">
        <label for="description" class="form-label">Description:</label>
        <textarea name="description" id="description" class="form-control"><%=listing.description%></textarea>
    </div>

    <div class="mb-3">
        <label for="image" class="form-label">Image URL:</label>
        <input value="<%= listing.image %>" name="image" id="image" class="form-control" />
    </div>

    <div class="mb-3">
        <label for="price" class="form-label">Price:</label>
        <input value="<%= listing.price %>" name="price" id="price" class="form-control" required/>
    </div>

    <div class="mb-3">
        <label for="location" class="form-label">Location:</label>
        <input value="<%= listing.location %>" name="location" id="location" class="form-control" required/>
        <div class="valid-feedback">location is valid</div>
        <div class="invalid-feedback">invalid location</div>
    </div>

    <div class="mb-3">
        <label for="country" class="form-label">Country:</label>
        <input value="<%= listing.country %>" type="text" name="country" id="country" class="form-control" />
    </div>

    <div class="mb-3">
        <button type="submit" class="btn add-button">Update</button>
    </div>
</form>
</div>

</div>