<%- layout("/layouts/boilerplate") %>
  <div class="row">
    <div class="col-8 offset-4 mb-3">
      <h2>
        <%=listing.title%>
      </h2>
    </div>
    <div class="col-8 offset-4 mb-3">
      <div class="card listing-card" style="width: 18rem;">
        <img src="<%=listing.image%>" class="card-img-top" alt="image not found" width="24rem">
        <div class="card-body">
          <p><i>owned by : <%=listing.owner.username%> </i></p>
          <p class="card-text">
            <%=listing.description%>
          </p>
          <h5 class="card-text">＄<%= (listing.price !==undefined && listing.price !==null) ?
              listing.price.toLocaleString("en-IN") : '0' %> /night</h5>
          <div>location:<%=listing.location%>
          </div>
          <div>
            <%=listing.country%>
          </div>
          
          <div>
          <a href="/listings/<%=listing._id%>/edit" class="btn add-button">edit</a>
          &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
          <a href="/listings/<%=listing._id%>/remove" class="btn add-button btn-outline-dark">delete</a>
          </div>
        
        </div>
      </div>
    </div>
    <hr>
    <div class="col-8 offset-3 mb-3">
      <h4>Leave a review </h4>
      <form action="/listings/<%=listing._id%>/reviews" method="POST" novalidate class="needs-validation">
        <!-- <div>
          <label class="form-label"  for="rating">choose rating</label>
            <input class="form-range" type="range" min="0" max="5" id="rating" name="review[rating]" >
          </div> -->
          <fieldset class="starability-slot">
            <legend>Give rating:</legend>
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        <div>
          <label class="form-label" for="comment">comment</label>
            <textarea class="form-control" name="review[comment]" id="review" rows="4" cols="10" required></textarea>
            <div class="invalid-feedback">enter valid review</div>
        </div>
        
        <div class="mt-3 mb-3">
          <button class="btn btn-outline-success">submit</button>
        </div>
      </form>
    </div>
    <hr>
    <div class="col-8 offset-2">
      <h4>All reviews</h4>
      <div class="row">
      <% if(listing.reviews.length>0){ %>
       <%for (let review of listing.reviews){%>
        <div class="card col-6 ms-3 mb-5 mt-3" style="width: 22rem;" >
          <div class="card-body mt-3">
            <h4>Author:<%=review.owner.username%></h4>
            <p class="card-title">Rating:<%=review.rating%>⭑</p>
            <p class="starability-result" data-rating="<%= review.rating %>">
            </p>
            <p class="card-text"><%=review.comment%></p>
          </div>
          <form method="post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
          <button class="btn btn-sm btn-outline-secondary mt-3 mb-3">Delete
          </button>
          </form>
        </div>
        <%}%>
        <% } %>
      </div>
    </div>
  </div>